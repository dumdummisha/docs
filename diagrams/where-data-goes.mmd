  vision -. "6" .-> openai
  app -- "7" --> workers
  workers <-->|"8"| anthropic
  workers <-.->|"8"| openai
  workers <-->|"5"| services
  ext -- "9" --> tab
  tab -- "9" --> slack
  own <-.->|"10"| host
  workers <-.->|"10"| host
  ext <-.->|"10"| tabs
  tabs <-.-> sites
  own <-.->|"10"| desktop
  workers <-.->|"10"| desktop
  own <-.->|"11"| anthropic
  own <-.->|"11"| openai
