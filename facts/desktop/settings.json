{
  "fields": [
    {
      "field": "account",
      "description": "The Slack account the clone answers as, and your self-DM there.",
      "default": "Chosen when the settings are first saved; it never changes after.",
      "limits": {}
    },
    {
      "field": "icon",
      "description": "The emoji every post of the clone starts with. Writing it in a message calls the clone.",
      "default": ":misha:",
      "limits": {
        "name": {
          "pattern": "^[a-z0-9_+-]{1,64}$",
          "flags": "u"
        }
      }
    },
    {
      "field": "personality",
      "description": "Your words on how the clone sounds: tone and wording only, never what it may do.",
      "default": "Empty, so the clone's own plain style.",
      "limits": {
        "maxCharacters": 2000
      }
    },
    {
      "field": "routines",
      "description": "Your standing instructions for work: when something happens, what the clone does and what it tells you. They grant no access.",
      "default": "Empty, so none.",
      "limits": {
        "maxCharacters": 2000
      }
    },
    {
      "field": "notes",
      "description": "What the clone remembers, in your exact words, numbered from 1.",
      "default": "None.",
      "limits": {
        "maxNotes": 200,
        "maxCharactersEach": 1000
      }
    },
    {
      "field": "rules",
      "description": "Who the clone ignores or soft-ignores.",
      "default": "Nobody.",
      "limits": {
        "levels": [
          "ignore",
          "soft-ignore"
        ],
        "maxNameCharacters": 80
      }
    },
    {
      "field": "allowed",
      "description": "Who besides you may ask the clone for work.",
      "default": "Nobody but you.",
      "limits": {
        "maxNameCharacters": 80
      }
    },
    {
      "field": "watched",
      "description": "The channels the clone reads in full.",
      "default": "None.",
      "limits": {
        "channelId": {
          "pattern": "^[CG][A-Z0-9]{2,}$",
          "flags": "u"
        },
        "maxNameCharacters": 80
      }
    },
    {
      "field": "repositories",
      "description": "Your own folders the clone reads as they are, each with the remote its pull requests go to, and where its workers may merge.",
      "default": "None.",
      "limits": {
        "remote": {
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\/[a-z0-9-]{1,39}\\/(?!\\.{1,2}$)[a-z0-9._-]{1,100}$",
          "flags": "iu"
        }
      }
    },
    {
      "field": "connectors",
      "description": "The connectors the clone may use, which Misha loads everywhere while they are on and nowhere while they are off.",
      "default": "Handoff compaction.",
      "limits": {
        "names": [
          "atlassian",
          "aws",
          "browser",
          "compaction",
          "figma",
          "fireflies",
          "google"
        ]
      }
    },
    {
      "field": "compactAtTokens",
      "description": "How many tokens the clone's session grows to before it is compacted. On OpenCode it must be below the model's input limit.",
      "default": "Empty, so 750000 tokens on Claude Code, and OpenCode's own threshold there.",
      "limits": {
        "isWholeNumber": true,
        "minTokens": 1
      }
    },
    {
      "field": "runtime",
      "description": "The runtime the clone runs on. Switching to the other one starts a new session there; the settings, notes and routines stay.",
      "default": "Claude Code.",
      "limits": {
        "runtimes": [
          "Claude Code",
          "OpenCode"
        ]
      }
    },
    {
      "field": "models",
      "description": "For each runtime, the model and effort the clone thinks with there, from the models that runtime offers. A change takes effect on the next message, in the same session.",
      "default": "Empty for each, so claude-opus-5-5 at high on Claude Code and openai/gpt-6-astra at medium on OpenCode.",
      "limits": {}
    },
    {
      "field": "sessionEpoch",
      "description": "Moves on with each start fresh and each switch of runtime, so the next message starts a new session.",
      "default": "0",
      "limits": {}
    }
  ],
  "mutations": [
    {
      "type": "create",
      "description": "The first save of the whole settings, for an account that has none.",
      "setting": null,
      "window": [
        {
          "page": "Get started",
          "section": "Give me a face",
          "control": "Save and start",
          "note": null
        },
        {
          "page": "Get started",
          "section": "Give me a face",
          "control": "Keep the defaults",
          "note": null
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "set-rule",
      "description": "Ignore or soft-ignore a person.",
      "setting": "rules",
      "window": [
        {
          "page": "Settings",
          "section": "Who I ignore",
          "control": "Ignore",
          "note": "On someone Find someone in Slack found."
        },
        {
          "page": "Settings",
          "section": "Who I ignore",
          "control": "Soft-ignore",
          "note": "On someone Find someone in Slack found."
