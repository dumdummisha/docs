{
  "fields": [
    {
      "field": "account",
      "description": "The Slack account the clone answers as, and your self-DM there.",
      "default": "Chosen when the settings are first saved; it never changes after.",
      "limits": {}
    },
    {
      "field": "icon",
      "description": "The emoji every post of the clone starts with. Writing it in a message calls the clone.",
      "default": ":misha:",
      "limits": {
        "pattern": "^[a-z0-9_+-]{1,64}$"
      }
    },
    {
      "field": "personality",
      "description": "Your words on how the clone sounds: tone and wording only, never what it may do.",
      "default": "Empty, so the clone's own plain style.",
      "limits": {
        "maxCharacters": 2000
      }
    },
    {
      "field": "notes",
      "description": "What the clone remembers, in your exact words, numbered from 1.",
      "default": "None.",
      "limits": {
        "maxNotes": 200,
        "maxCharactersEach": 1000
      }
    },
    {
      "field": "rules",
      "description": "Who the clone ignores or soft-ignores.",
      "default": "Nobody.",
      "limits": {
        "levels": [
          "ignore",
          "soft-ignore"
        ],
        "maxNameCharacters": 80
      }
    },
    {
      "field": "allowed",
      "description": "Who besides you may ask the clone for work.",
      "default": "Nobody but you.",
      "limits": {
        "maxNameCharacters": 80
      }
    },
    {
      "field": "watched",
      "description": "The channels the clone reads in full.",
      "default": "None.",
      "limits": {
        "channelId": "^[CG][A-Z0-9]{2,}$",
        "maxNameCharacters": 80
      }
    },
    {
      "field": "repositories",
      "description": "The GitHub repositories the clone keeps read-only copies of, and where its workers may merge.",
      "default": "None.",
      "limits": {
        "owner": "^[a-z0-9-]{1,39}$",
        "name": "^(?!\\.{1,2}$)[a-z0-9._-]{1,100}$"
      }
    },
    {
      "field": "integrations",
      "description": "The integrations the clone may use, each only while its sign-in on this Mac also works.",
      "default": "None.",
      "limits": {
        "names": [
          "github",
          "gpt",
          "google",
          "aws",
          "atlassian",
          "fireflies",
          "figma"
        ]
      }
    },
    {
      "field": "compactAtTokens",
      "description": "How many tokens the clone's Claude session grows to before it is compacted.",
      "default": "Empty, so 750000 tokens.",
      "limits": {}
    },
    {
      "field": "sessionEpoch",
      "description": "Moves on with each start fresh, so the next message starts a new Claude session.",
      "default": "0",
      "limits": {}
    }
  ],
  "mutations": [
    {
      "type": "create",
      "description": "The first save of the whole settings, for an account that has none.",
      "setting": null,
      "window": [
        {
          "page": "Get started",
          "section": "Give me a face",
          "control": "Save and start, or Keep the defaults"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "set-rule",
      "description": "Ignore or soft-ignore a person.",
      "setting": "rules",
      "window": [
        {
          "page": "Settings",
          "section": "Who I ignore",
          "control": "Find someone in Slack, then Ignore or Soft-ignore"
        }
      ],
      "slackCommands": [
        "ignore",
        "soft-ignore"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "remove-rule",
      "description": "Stop ignoring or soft-ignoring a person.",
      "setting": "rules",
      "window": [
        {
          "page": "Settings",
          "section": "Who I ignore",
          "control": "Stop ignoring"
        }
      ],
      "slackCommands": [
        "stop-ignoring"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "allow",
      "description": "Let people ask the clone for work.",
      "setting": "allowed",
      "window": [
        {
          "page": "Settings",
          "section": "Who may ask me for work",
          "control": "Find someone in Slack, then Allow"
        }
      ],
      "slackCommands": [
        "allow"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "disallow",
      "description": "Stop letting a person ask the clone for work.",
      "setting": "allowed",
      "window": [
        {
          "page": "Settings",
          "section": "Who may ask me for work",
          "control": "Stop allowing"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "watch",
      "description": "Have the clone read channels in full.",
      "setting": "watched",
      "window": [
        {
          "page": "Settings",
          "section": "Channels I watch",
          "control": "Find a channel in Slack, then Watch"
        }
      ],
      "slackCommands": [
        "watch"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "unwatch",
      "description": "Stop the clone reading a channel in full.",
      "setting": "watched",
      "window": [
        {
          "page": "Settings",
          "section": "Channels I watch",
          "control": "Stop watching"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "set-merging",
      "description": "Let workers merge reviewed pull requests in a repository, or stop them.",
      "setting": "repositories",
      "window": [
        {
          "page": "Settings",
          "section": "Repositories",
          "control": "May merge"
        }
      ],
      "slackCommands": [
        "allow-merging",
        "stop-merging"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "add-repository",
      "description": "Add a repository the clone keeps a copy of.",
      "setting": "repositories",
      "window": [
        {
          "page": "Settings",
          "section": "Repositories",
          "control": "Add"
        },
        {
          "page": "Get started",
          "section": "Show me your code",
          "control": "Add"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "remove-repository",
      "description": "Remove a repository and its copy.",
      "setting": "repositories",
      "window": [
        {
          "page": "Settings",
          "section": "Repositories",
          "control": "Remove"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "remember",
      "description": "Keep your words as the next note.",
      "setting": "notes",
      "window": [
        {
          "page": "Settings",
          "section": "What I remember",
          "control": "Remember"
        }
      ],
      "slackCommands": [
        "remember"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "forget",
      "description": "Forget a note; the notes after it move up a number.",
      "setting": "notes",
      "window": [
        {
          "page": "Settings",
          "section": "What I remember",
          "control": "Forget"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "start-fresh",
      "description": "Start the clone's next message in a new Claude session.",
      "setting": "sessionEpoch",
      "window": [
        {
          "page": "Settings",
          "section": "Start fresh",
          "control": "Start fresh…"
        }
      ],
      "slackCommands": [
        "start-fresh"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "set-icon",
      "description": "Change the clone's icon.",
      "setting": "icon",
      "window": [
        {
          "page": "Settings",
          "section": "Icon",
          "control": "Save icon"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "set-personality",
      "description": "Change the clone's personality.",
      "setting": "personality",
      "window": [
        {
          "page": "Settings",
          "section": "Personality",
          "control": "Save personality"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "set-integration",
      "description": "Turn an integration on or off.",
      "setting": "integrations",
      "window": [
        {
          "page": "Set up",
          "section": "What I can read",
          "control": "I use it, on each integration's row (OpenCode's and the GitHub CLI's too)"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "set-compact-at-tokens",
      "description": "Change when the clone's session is compacted, or go back to the default.",
      "setting": "compactAtTokens",
      "window": [
        {
          "page": "Settings",
          "section": "When I tidy my conversation",
          "control": "Save"
        }
      ],
      "slackCommands": [],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "describe",
      "description": "Show the settings; changes nothing.",
      "setting": null,
      "window": [],
      "slackCommands": [
        "settings"
      ],
      "setupTool": "misha_apply_setting"
    },
    {
      "type": "soft-ignore-me",
      "description": "A colleague has the clone answer them only when they call it.",
      "setting": "rules",
      "window": [],
      "slackCommands": [
        "soft-ignore-me"
      ],
      "setupTool": null
    },
    {
      "type": "stop-ignoring-me",
      "description": "A colleague has the clone treat them like everyone else again.",
      "setting": "rules",
      "window": [],
      "slackCommands": [
        "stop-ignoring-me"
      ],
      "setupTool": null
    },
    {
      "type": "hands-off",
      "description": "Keep the clone out of a thread or DM.",
      "setting": null,
      "window": [],
      "slackCommands": [
        "hands-off"
      ],
      "setupTool": null
    },
    {
      "type": "hands-on",
      "description": "Let the clone answer in a thread or DM again.",
      "setting": null,
      "window": [],
      "slackCommands": [
        "hands-on"
      ],
      "setupTool": null
    },
    {
      "type": "pause",
      "description": "Pause Misha.",
      "setting": null,
      "window": [
        {
          "page": "rail",
          "section": "The account",
          "control": "Pause Misha"
        }
      ],
      "slackCommands": [
        "pause"
      ],
      "setupTool": "misha_pause"
    },
    {
      "type": "resume",
      "description": "Resume Misha.",
      "setting": null,
      "window": [
        {
          "page": "rail",
          "section": "The account",
          "control": "Resume Misha"
        },
        {
          "page": "Home",
          "section": "I'm paused.",
          "control": "Resume"
        }
      ],
      "slackCommands": [
        "resume"
      ],
      "setupTool": "misha_resume"
    }
  ]
}
